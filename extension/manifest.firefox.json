{
  "manifest_version": 3,
  "name": "LessonShelf \u00b7 Local Video",
  "version": "0.3.1",
  "description": "A private, local download queue for classroom videos you have permission to save.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "nativeMessaging",
    "downloads"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LessonShelf",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "teacher-video-downloader@local.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "browsingActivity",
          "websiteContent"
        ]
      },
      "update_url": "https://mr-gullo.github.io/teacher-video-downloader/updates/firefox.json"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      }
    }
  }
}
